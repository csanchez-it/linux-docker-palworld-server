# Palworld Dedicated Server - Environment Configuration Example
# Copy this file to ".env" and adjust values as needed.
# Do NOT commit a real .env file with production credentials or IPs.

# ---- Server identity ----
SERVER_NAME=Servidor de prueba
SERVER_DESCRIPTION=Personal test server for learning Docker & Linux administration
ADMIN_PASSWORD=changeme
SERVER_PASSWORD=changeme

# ---- Capacity ----
PLAYERS=16

# ---- Networking ----
PORT=8211
REST_API_PORT=8212
PUBLIC_IP=your.server.ip
PUBLIC_PORT=8211

# ---- Gameplay tuning ----
PAL_EGG_DEFAULT_HATCHING_TIME=0.0167
PLAYER_STOMACH_DECREACE_RATE=0.5
PAL_STOMACH_DECREACE_RATE=0.5
ITEM_CORRUPTION_MULTIPLIER=0.1

# ---- Planned / researched (not implemented at decommission) ----
